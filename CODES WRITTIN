cd "C:\Users\ACER\Downloads\isef project"


2. KRAS G12C zülalının hazırlanması
2.1. KRAS strukturundan OHY ligandının çıxarılması
Get-Content KRAS_G12C.pdb | Where-Object { $_ -notmatch "OHY" } | Set-Content KRAS_G12C_noOHY.pdb


2.2. Yalnız zülal atomlarının saxlanılması
findstr "^ATOM" KRAS_G12C_noOHY.pdb > KRAS_G12C_protein.pdb


2.3. Faylın ASCII formatına çevrilməsi
Get-Content KRAS_G12C_protein.pdb | Set-Content KRAS_G12C_protein_ascii.pdb -Encoding ascii


2.4. A zəncirinin seçilməsi
Get-Content KRAS_G12C_protein_ascii.pdb | Where-Object { $_.Substring(21,1) -eq "A" } | Set-Content KRAS_G12C_A.pdb -Encoding ascii


2.5. KRAS receptor-un hazırlanması
C:\Users\ACER\AppData\Local\Programs\Python\Python312\Scripts\mk_prepare_receptor.exe --read_pdb KRAS_G12C_A.pdb -o KRAS_G12C_receptor -p --default_altloc A


3. KRAS docking konfiqurasiya faylı
Faylın adı: KRAS_config.txt
receptor = KRAS_G12C_receptor.pdbqt
center_x = 4.94
center_y = -0.31
center_z = -13.55
size_x = 20
size_y = 20
size_z = 20


4. KRAS üçün docking
Catechin ilə ilk sınaq:
.\Vina.exe --config KRAS_config.txt --ligand Catechin.pdbqt --out KRAS_Catechin_out.pdbqt


Qalan ligandların avtomatik docking edilməsi:
Get-ChildItem *.pdbqt | Where-Object {$_.Name -notlike "*_out.pdbqt" -and $_.Name -notlike "*receptor.pdbqt"} | Where-Object {$_.Name -ne "catechin.pdbqt"} | ForEach-Object { .\Vina.exe --config KRAS_config.txt --ligand $_.FullName --out "KRAS_$($_.BaseName)_out.pdbqt" }


5. MET zülalının hazırlanması
5.1. MET strukturunun ASCII formatına çevrilməsi
Get-Content MET.pdb | Set-Content MET_ascii.pdb -Encoding ascii


5.2. MET receptor-un hazırlanması
C:\Users\ACER\AppData\Local\Programs\Python\Python312\Scripts\mk_prepare_receptor.exe --read_pdb MET_ascii.pdb -o MET_receptor -p --delete_bad_res


5.3. Kristal ligand VGH atomlarının çıxarılması
findstr "^HETATM" MET.pdb | findstr "VGH" > VGH.txt


5.4. VGH koordinatlarının çıxarılması
Get-Content VGH.txt | ForEach-Object { $_.Substring(30,24) } | Set-Content VGH_coords.txt


